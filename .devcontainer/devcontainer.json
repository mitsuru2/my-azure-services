// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
  "name": "my-azure-services",
  "build": {
    // Sets the run context to one level up instead of the .devcontainer folder.
    "context": "..",
    // Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
    "dockerfile": "../Dockerfile"
  },

  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},

  // NET_ADMIN/NET_RAW are required by scripts/init-firewall.sh (iptables/ipset) to
  // restrict outbound network access to an allowlist for Claude Code sessions.
  // --env-file injects .devcontainer/secrets.env as real container environment
  // variables (available to every process, including VS Code extensions such as
  // Claude Code) rather than only the integrated terminal. Editing secrets.env
  // requires a container rebuild (not just reopening a terminal) to take effect.
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--env-file",
    ".devcontainer/secrets.env"
  ],

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Uncomment the next line to run commands after the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "initializeCommand": "touch .devcontainer/secrets.env",

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "anthropic.claude-code",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-bicep"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  },

  // Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "node",

  // ボリューム名はホスト全体で共有されるため、同名フォルダの別プロジェクトとも衝突しないよう
  // ワークスペースごとに一意で、リビルドしても変わらない devcontainerId を含める。
  // (先頭の localWorkspaceFolderBasename は docker volume ls で識別しやすくするため)
  "mounts": [
    // Uncomment the following line if you want to persist Azurite data between container rebuilds. This is not necessary if you are using a real Azure Storage account.
    // "source=${localWorkspaceFolderBasename}-${devcontainerId}-azurite,target=/workspaces/.azurite,type=volume",
    "source=${localWorkspaceFolderBasename}-${devcontainerId}-azure,target=/home/node/.azure,type=volume",
    "source=${localWorkspaceFolderBasename}-${devcontainerId}-claude,target=/home/node/.claude,type=volume",
    // node_modules をバインドマウントから切り離して I/O を高速化する
    "source=${localWorkspaceFolderBasename}-${devcontainerId}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ]
}
